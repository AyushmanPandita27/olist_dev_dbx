{
	"name": "PL_SAP_Customer_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "GM_Check_Customer_File",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_SFTP_SAP_Customer",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "SftpReadSettings",
						"enablePartitionDiscovery": false,
						"disableChunking": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "IF_Customer_File_Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "GM_Check_Customer_File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('GM_Check_Customer_File').output.exists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FAIL_Customer_File_Missing",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Customer file was not received from SAP SFTP source.",
								"errorCode": "CUSTOMER_FILE_MISSING"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy data1",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "SET_Status_Processing",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "SftpReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false,
										"disableChunking": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_SFTP_SAP_Customer",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_SAP_Customer_Landing",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "SET_Status_Processing",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_status",
								"value": "PROCESSING"
							}
						}
					]
				}
			},
			{
				"name": "GM_Validate_Customer_Landing",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "IF_Customer_File_Exists",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_SAP_Customer_Landing",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "IF_Customer_Landing_Exists",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "GM_Validate_Customer_Landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('GM_Validate_Customer_Landing').output.exists",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "FAIL_Customer_Landing_Missing",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Customer file was copied successfully but was not found in ADLS Landing during validation.",
								"errorCode": "CUSTOMER_LANDING_MISSING"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "SET_Status_Success",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_status",
								"value": "SUCCESS"
							}
						}
					]
				}
			}
		],
		"variables": {
			"v_source_system": {
				"type": "String",
				"defaultValue": "SAP"
			},
			"v_entity": {
				"type": "String",
				"defaultValue": "Customer"
			},
			"v_status": {
				"type": "String",
				"defaultValue": "STARTED"
			}
		},
		"annotations": []
	}
}